GEMINI_API_KEY=
GROQ_API_KEY=

# Optional overrides (defaults shown)
# OLLAMA_BASE_URL=http://localhost:11434
# DATABASE_URL=postgresql+psycopg://incident:incident@localhost:5433/incident_agent
# AGENT_MODEL=gemini:gemini-3.5-flash-lite
# FALLBACK_MODELS=["gemini:gemini-3.1-flash-lite","groq:openai/gpt-oss-120b","ollama:qwen3:4b"]
# GRADER_MODEL=groq:qwen/qwen3.8-27b
# EMBEDDING_CACHE_DIR=.cache/fastembed   (default: <repo>/.cache/fastembed)
# LIVE_ENABLED=true              (API: allow live investigations; recorded replays always work)
# LIVE_DAILY_LIMIT=20            (API: live investigations per UTC day)
# ALERT_DAILY_LIMIT=10           (API: alert-triggered investigations per UTC day)
# ALERT_WEBHOOK_TOKEN=           (API: bearer token of POST /api/alerts/{id}/investigate; unset = endpoint off)
# CORS_ORIGINS=["http://localhost:3000"]
